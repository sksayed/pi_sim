[Unit]
Description=MQTT LightGBM Inline Firewall (CIC IoMT 2024)
After=network.target mosquitto.service
Requires=mosquitto.service

[Service]
Type=simple
EnvironmentFile=/home/sayed/journal_paper_proj/pi_sim/.env
ExecStart=/home/sayed/journal_paper_proj/pi_sim/.venv/bin/python /home/sayed/journal_paper_proj/pi_sim/firewall/mqtt_firewall.py
Restart=always
RestartSec=5
User=root
WorkingDirectory=/home/sayed/journal_paper_proj/pi_sim/firewall
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target