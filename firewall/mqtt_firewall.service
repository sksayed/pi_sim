[Unit]
Description=MQTT LightGBM Inline Firewall (CIC IoMT 2024)
After=network.target mosquitto.service
Requires=mosquitto.service

[Service]
Type=simple
EnvironmentFile=@@REPO_ROOT@@/.env
ExecStart=@@REPO_ROOT@@/.venv/bin/python @@REPO_ROOT@@/firewall/mqtt_firewall.py
Restart=always
RestartSec=5
User=root
WorkingDirectory=@@REPO_ROOT@@/firewall
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
