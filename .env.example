# Copy to `.env` and edit values for your machine.
# Example:
#   cp .env.example .env
#
# Generate a strong secret once and reuse it on all participating nodes:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ── Core security key ──────────────────────────────────────────────────────────
# Shared root secret used by key derivation on client and gateway.
# Must be identical on all nodes or decrypt/verify will fail.
MASTER_SECRET=replace-with-your-64-char-hex-secret

# ── Local network / host metadata ──────────────────────────────────────────────
# Optional: informational Wi-Fi SSID value for your deployment notes.
NETWORK_SSID=YourWiFiSSID

# ── Optional external service credentials ──────────────────────────────────────
# Used only if your workflow integrates with Gitea scripts/tools.
GITEA_USER=your_username
GITEA_PASSWORD=your_password

# ── MQTT gateway/broker connection ─────────────────────────────────────────────
# IP/hostname of the machine running Mosquitto.
# Use 127.0.0.1 when gateway + broker run on the same host.
GATEWAY_IP=192.168.1.XX
# Default MQTT TCP port.
GATEWAY_PORT=1883

# ── Client behavior ─────────────────────────────────────────────────────────────
# Logical client/device id used by client scripts.
CLIENT_ID=client-a
# Publish interval in seconds for periodic client sends.
PUBLISH_INTERVAL=2

# ── Firewall settings (firewall/mqtt_firewall.py) ─────────────────────────────
# NFQUEUE index. Must match your iptables rule:
#   -j NFQUEUE --queue-num <FW_QUEUE_NUM>
FW_QUEUE_NUM=0

# Path to trained LightGBM model file used for classification.
FW_MODEL_PATH=firewall/lightgbm_model.txt
# Optional scaler (.pkl). Keep empty if model expects raw features.
FW_SCALER_PATH=

# Flow handling:
# - classify a flow after this many idle seconds
FW_FLOW_TIMEOUT_S=10
# - require at least this many packets before classification
FW_MIN_PKTS_CLASSIFY=3

# Classification threshold: attack if probability > this value.
FW_ATTACK_THRESHOLD=0.5

# Optional label mapping for multiclass models.
# Comma-separated class names in exact training-order.
# Leave empty to use generic names like class_0,class_1,...
FW_CLASS_NAMES=
# Which label name should be treated as benign.
FW_BENIGN_LABEL=Benign

# Enforcement mode:
# true  -> IPS mode (insert iptables DROP for attack source IP)
# false -> IDS mode (log only, do not drop)
FW_BLOCK_VERDICT=true
# Auto-unblock timer in seconds (0 means never auto-unblock).
FW_BLOCK_TTL_S=0

# Human-readable text log path.
FW_LOG_FILE=Firewall_logs/mqtt_firewall.log
# Structured JSON-lines event log path (one JSON object per line).
FW_JSONL_FILE=Firewall_logs/mqtt_firewall.jsonl
# true = emit per-packet detail logs (high volume).
FW_VERBOSE_PACKET_LOGS=true
# true = emit structured JSON event records.
FW_JSON_EVENT_LOGS=true
