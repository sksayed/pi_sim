# ── Shared secret (copy this file to .env and fill in values) ─────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_SECRET=replace-with-your-64-char-hex-secret

# ── Network ───────────────────────────────────────────────────────────────────
NETWORK_SSID=YourWiFiSSID

# ── Crypto ────────────────────────────────────────────────────────────────────
MASTER_SECRET=your_64_char_hex_secret

# ── Gitea ─────────────────────────────────────────────────────────────────────
GITEA_USER=your_username
GITEA_PASSWORD=your_password

# ── Gateway (Broker) Pi ───────────────────────────────────────────────────────
# Run `hostname -I` on the Gateway Pi to find its IP.
GATEWAY_IP=192.168.1.XX
GATEWAY_PORT=1883

# ── Client identity ───────────────────────────────────────────────────────────
# Set to the device running on this Pi: client-a | client-b | client-c
CLIENT_ID=client-a

# ── Behaviour ─────────────────────────────────────────────────────────────────
PUBLISH_INTERVAL=2
