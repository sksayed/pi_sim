# ── Shared secret ──────────────────────────────────────────────────────────────
# Master key material used by clients and gateway for deterministic key
# derivation. For real experiments this should be a strong 64-character hex
# string and must be kept private.
MASTER_SECRET=c115cfd7885aab6cc87ae0bd6938a4e9fe8d0a88fe24f13643ce1b369f05da0b

# ── Network ───────────────────────────────────────────────────────────────────
# Wi-Fi/network name used by helper scripts or documentation.
NETWORK_SSID=Redmi Note 12 Pro 5G

# ── Gitea ─────────────────────────────────────────────────────────────────────
# Credentials for local/private Gitea automation if used by scripts.
# Keep these private; they are not required for MQTT/PQC runtime.
GITEA_USER=sayed
GITEA_PASSWORD=sayed1234

# ── Gateway (Broker) Pi ───────────────────────────────────────────────────────
# MQTT broker / gateway host. Use 127.0.0.1 when clients run on the same machine;
# use the gateway Pi IP address when remote clients publish over the network.
GATEWAY_IP=127.0.0.1
# MQTT broker port. Default Mosquitto MQTT is 1883.
GATEWAY_PORT=1883

# ── Client identity ───────────────────────────────────────────────────────────
# Default logical client/device ID used by client scripts that read CLIENT_ID.
CLIENT_ID=pi-client-01

# ── MQTT topic ────────────────────────────────────────────────────────────────
# Default topic for older/simple clients. Most project clients publish to
# nodes/{device_id}/data.
MQTT_TOPIC=pi/sensor/data

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Seconds between normal client publishes.
PUBLISH_INTERVAL=2

# ── Stack starter (scripts/start_stack.py) ────────────────────────────────────
# Optional. If set, start_stack.py can pass this to sudo -S for service/iptables
# operations. Prefer running interactively or using sudo credential caching.
# STACK_SUDO_PASSWORD=

# ── Firewall (mqtt_firewall.py) ───────────────────────────────────────────────
# NFQUEUE number. Must match iptables rules, e.g.
#   -j NFQUEUE --queue-num 0
FW_QUEUE_NUM=0

# LightGBM model file used for IDS/IPS classification.
FW_MODEL_PATH=/home/sayed/journal_paper_proj/pi_sim/firewall/lightgbm_model.txt

# Optional scaler used before LightGBM prediction. Leave empty to disable.
FW_SCALER_PATH=/home/sayed/journal_paper_proj/pi_sim/firewall/standard_scaler.pkl

# Idle seconds before an unfinished flow is classified by the background reaper.
FW_FLOW_TIMEOUT_S=10

# Minimum total packets in a flow before the firewall is allowed to classify it.
FW_MIN_PKTS_CLASSIFY=20

# Attack decision threshold. Higher = fewer blocks/alerts; lower = more aggressive.
FW_ATTACK_THRESHOLD=0.5

# Ordered class labels matching the model training label encoding.
# The benign label below must exactly match one item in this list.
FW_CLASS_NAMES=ARP_Spoofing,Benign,MQTT-DDoS-Connect_Flood,MQTT-DDoS-Publish_Flood,MQTT-DoS-Connect_Flood,MQTT-DoS-Publish_Flood,MQTT-Malformed_Data,Recon-OS_Scan,Recon-Ping_Sweep,Recon-Port_Scan,Recon-VulScan,TCP_IP-DDoS-ICMP1,TCP_IP-DDoS-ICMP2,TCP_IP-DDoS-SYN,TCP_IP-DDoS-TCP,TCP_IP-DDoS-UDP1,TCP_IP-DDoS-UDP2,TCP_IP-DoS-ICMP,TCP_IP-DoS-SYN,TCP_IP-DoS-TCP,TCP_IP-DoS-UDP

# Label treated as benign by the multiclass decision logic.
FW_BENIGN_LABEL=Benign

# IDS/IPS switch:
#   false = IDS mode: classify and log only, no blocking.
#   true  = IPS mode: when a flow is classified as ATTACK, add an iptables DROP
#           rule for the detected source IP + source port + destination port
#           instead of blocking every connection from that client IP.
FW_BLOCK_VERDICT=true

# Auto-unblock time in seconds for IPS blocks.
#   0 or negative = keep block until manual cleanup/restart.
#   >0            = remove DROP rule after this many seconds.
FW_BLOCK_TTL_S=0

# Human-readable firewall log path.
FW_LOG_FILE=/home/sayed/journal_paper_proj/pi_sim/Firewall_logs/mqtt_firewall.log

# Machine-readable JSON Lines event log path.
FW_JSONL_FILE=/home/sayed/journal_paper_proj/pi_sim/Firewall_logs/mqtt_firewall.jsonl

# true = log one human-readable line for every parsed packet; can be noisy.
FW_VERBOSE_PACKET_LOGS=true

# true = write structured JSONL events such as packet_parsed, verdict,
# block_applied, block_removed, and block_ttl_expired.
FW_JSON_EVENT_LOGS=true

# For long-lived MQTT connections, classify every N packets even without FIN/RST.
# Lower = faster verdicts but more CPU/logging; higher = less overhead.
FW_CLASSIFY_EVERY_N_PKTS=50

# ── Cloud HTTPS (managed by python -m cloud.setup_gateway) ──
GW_CLOUD_FORWARD=1
CLOUD_URL=https://10.111.108.55:8443/v1/envelope
GATEWAY_SIG_SK=keys/gateway/sig.sk
GATEWAY_CLOUD_PK=keys/cloud/kem.pk
GATEWAY_TRUST=keys/trust.json
CLOUD_TLS_CERT=keys/tls/cloud.crt
GW_CLOUD_LOG=results/gateway/cloud_uplink.jsonl
GW_CLOUD_RETRIES=3
